# ------------------------------------------------------------
# Battle Born Custom Trailers — environment variables
# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# ------------------------------------------------------------

# Gmail account that SENDS the emails (the SMTP login)
GMAIL_USER=battleborntrailers@gmail.com

# 16-character Gmail App Password (NOT the normal Gmail password).
# Google Account → Security → 2-Step Verification (must be ON) → App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Inbox that RECEIVES quote requests & trailer designs (comma-separate for several)
CONTACT_TO_EMAIL=battleborntrailers@gmail.com

# Send customers an automatic "we got your request" email (true/false)
SEND_CONFIRMATION_EMAIL=true

# Public site URL — used for design links in emails, sitemap and social previews
NEXT_PUBLIC_SITE_URL=https://battleborncustomtrailers.com
